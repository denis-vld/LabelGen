####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/LabelGen/bin || mkdir -p $(INSTALL_ROOT)/opt/LabelGen/bin
	$(QINSTALL_PROGRAM) build/linux/release/bin/$(QMAKE_TARGET) $(INSTALL_ROOT)/opt/LabelGen/bin/$(QMAKE_TARGET)
	-$(STRIP) $(INSTALL_ROOT)/opt/LabelGen/bin/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/opt/LabelGen/bin/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/LabelGen/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

FORCE:

